# ─── OpenCode + provider API (setup/setup_opencode.sh, setup/set_model.sh) ───
# OpenCode model. Default target is NVIDIA NIM DeepSeek V4 Pro.
OPENCODE_MODEL=nvidia/deepseek-ai/deepseek-v4-pro

# NVIDIA Build / NIM key.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# The harness assumes a sandbox and headless, unattended operation, so it runs
# OpenCode with --dangerously-skip-permissions by default (this holds even if the
# var is unset). Set to 0 ONLY for manual, supervised runs in a trusted env.
OPENCODE_AUTO_APPROVE=1

# Keep OpenCode session continuity in addition to file-based history.
# The harness already passes state/history.jsonl into every prompt, so 0 is the simpler default.
OPENCODE_CONTINUE=0

# ─── Orchestrator (setup/setup_orchestrator.sh) ───
# Decision backend, no hard default: none | nemotron | openclaw | custom
#   none      rule-based keyword routing, no model (works offline)
#   nemotron  NVIDIA NIM chat model (uses ORCH_MODEL + NVIDIA_API_KEY)
#   openclaw  external command (ORCH_CMD): message on stdin -> action JSON on stdout
#   custom    external command (ORCH_CMD): same contract as openclaw
ORCH_BACKEND=none
# Model id for ORCH_BACKEND=nemotron (verify availability at build.nvidia.com).
ORCH_MODEL=
# Command for ORCH_BACKEND=openclaw|custom.
ORCH_CMD=
# Default iterations per "run" request, and poll interval (seconds) in serve mode.
ORCH_ITERATIONS=1
ORCH_POLL_SECONDS=10

# ─── Messaging (setup/setup_messaging.sh) ───
# Backend: localfile | ntfy | telegram | discord  (default: localfile, no external egress)
MESSAGING_BACKEND=localfile
# ntfy.sh — sends to an external service; use a private, unguessable topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord incoming webhook (send-only).
DISCORD_WEBHOOK_URL=
