# ─── OpenCode + provider API (setup/setup_opencode.sh, setup/set_model.sh) ───
# OpenCode model. Default target is NVIDIA NIM DeepSeek V4 Pro.
OPENCODE_MODEL=nvidia/deepseek-ai/deepseek-v4-pro

# NVIDIA Build / NIM key.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Fallback model chain. NVIDIA NIM's stronger models are frequently overloaded or
# unavailable; when the preferred OPENCODE_MODEL fails (nonzero exit, or a hang past
# OPENCODE_TIMEOUT_SECONDS), the harness retries with these models in order, left to
# right. Comma-separated; leave empty to disable fallback.
#
# Good free targets are OpenCode Zen models — the built-in `opencode` provider. Run
# `opencode auth login` once and pick "OpenCode Zen"; the free tier needs no API key.
# They use the `opencode/<id>` form. The free set rotates (recent ones include Big
# Pickle, MiMo V2, MiniMax M2.5, Nemotron 3 Super), so look up the exact current ids
# instead of trusting a hardcoded list:
#   setup/set_model.sh list          # i.e. `opencode models` — authoritative, current
#   also: https://opencode.ai/zen   or  `/models` in the OpenCode TUI
# Then set them here, preferred-first, e.g.:
#   OPENCODE_FALLBACK_MODELS=opencode/big-pickle,opencode/nemotron-3-super
# You can also chain across providers (e.g. an OpenRouter ':free' model) by adding
# that provider's API key below.
OPENCODE_FALLBACK_MODELS=

# Abandon a single OpenCode attempt after this many seconds and fall back to the next
# model in the chain. Useful because an overloaded provider can hang instead of
# erroring. 0 = no time limit (default).
OPENCODE_TIMEOUT_SECONDS=0

# The harness assumes a sandbox and headless, unattended operation, so it runs
# OpenCode with --dangerously-skip-permissions by default (this holds even if the
# var is unset). Set to 0 ONLY for manual, supervised runs in a trusted env.
OPENCODE_AUTO_APPROVE=1

# Keep OpenCode session continuity in addition to file-based history.
# The harness already passes state/history.jsonl into every prompt, so 0 is the simpler default.
OPENCODE_CONTINUE=0

# ─── Knowledge base (all optional; safe defaults, no setup required) ───
# A knowledge_base text file is inlined in the prompt in full only if it is at most this
# many bytes; larger text, all PDFs/binaries, and anything under knowledge_base/library/
# are listed in a manifest and extracted on demand by the kb-researcher subagent.
KB_INLINE_MAX_BYTES=16384
# Stop inlining once the cumulative inlined text reaches this many bytes.
KB_INLINE_TOTAL_BYTES=65536
# Model for the kb-researcher extraction subagent. Empty = the lighter flash-tier default
# baked into opencode.jsonc; set a provider/model-id to override it. This subagent also
# runs on NVIDIA NIM by default, so if NIM is unreliable point it at a free model too,
# e.g. an `opencode/<id>` OpenCode Zen model (see OPENCODE_FALLBACK_MODELS above).
KB_AGENT_MODEL=

# ─── Orchestrator (setup/setup_orchestrator.sh) ───
# Decision backend, no hard default: none | nemotron | openclaw | custom
#   none      rule-based keyword routing, no model (works offline)
#   nemotron  NVIDIA NIM chat model (uses ORCH_MODEL + NVIDIA_API_KEY)
#   openclaw  external command (ORCH_CMD): message on stdin -> action JSON on stdout
#   custom    external command (ORCH_CMD): same contract as openclaw
ORCH_BACKEND=none
# Model id for ORCH_BACKEND=nemotron (verify availability at build.nvidia.com).
ORCH_MODEL=
# Command for ORCH_BACKEND=openclaw|custom.
ORCH_CMD=
# Default iterations per "run" request, and poll interval (seconds) in serve mode.
ORCH_ITERATIONS=1
ORCH_POLL_SECONDS=10

# ─── Messaging (setup/setup_messaging.sh) ───
# Backend: localfile | ntfy | telegram | discord  (default: localfile, no external egress)
MESSAGING_BACKEND=localfile
# ntfy.sh — sends to an external service; use a private, unguessable topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord incoming webhook (send-only).
DISCORD_WEBHOOK_URL=
